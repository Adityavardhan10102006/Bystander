# ─────────────────────────────────────────────────────────────────────────────
# Bystander — Environment Variables
#
# Copy this file to .env and fill in the values before starting.
# The app WILL REFUSE TO START if any required variable is missing.
# Generate secrets with: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/bystander"

# --- Redis (queues + pub/sub for realtime) ---
REDIS_URL="redis://localhost:6379"

# --- Hosted AI provider ---
# Used for NLP: sentiment/emotion analysis AND mediation text generation
# One provider, one structured call per message.
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-6"

# --- Chat platform: Discord ---
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_CLIENT_ID=""

# --- Ingestion security (REQUIRED) ---
# Shared secret between the Discord bot and the /api/ingestion/discord endpoint.
# Security fails CLOSED: if missing, ALL ingestion requests are rejected.
# Generate: openssl rand -base64 32
INGESTION_SECRET=""

# --- Internal DM notification server (REQUIRED) ---
# Shared secret for the bot's internal HTTP server (:3001/notify).
# Security fails CLOSED: if missing, ALL notify requests are rejected.
# Generate: openssl rand -base64 32
NOTIFY_SECRET=""

# --- NextAuth ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- OAuth Providers ---
# GitHub: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google: https://console.cloud.google.com → Credentials → OAuth 2.0
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cron security (REQUIRED) ---
# Vercel Cron sends this as: Authorization: Bearer <CRON_SECRET>
# Security fails CLOSED: if missing, the purge endpoint rejects ALL requests.
# Generate: openssl rand -base64 32
CRON_SECRET=""

# --- Message retention ---
# Raw text purge job interval, in hours, for closed/archived threads
RETENTION_PURGE_INTERVAL_HOURS=24

# --- Demo mode ---
# When true, the dashboard returns a deterministic demo dataset.
# Use this for hackathon demos when you don't have a real Discord server ready.
# NEVER enable in production.
DEMO_MODE=false

# --- Bot internal notify server ---
NOTIFY_PORT=3001
# URL of the running Next.js app (used by the bot to forward messages)
BYSTANDER_API_URL="http://localhost:3000"

# --- Logging ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL="info"
