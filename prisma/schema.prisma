// Bystander data model
// Retention policy (confirmed):
// - Raw message text persists for the lifetime of the active ConversationThread,
//   purged on thread close/archive by a scheduled job.
// - Derived signals (embeddings, sentiment, tension history) persist independently
//   of raw text, since long-term trend views (Team Health Dashboard, Relationship
//   Timeline) need history even after raw content is purged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThreadStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum Platform {
  DISCORD
  SLACK
  TEAMS
  WHATSAPP
  TELEGRAM
  GOOGLE_CHAT
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

enum ServerRole {
  ADMIN
  MODERATOR
  MEMBER
}

// ---------------------------------------------------------------------------
// Intervention delivery status
// ---------------------------------------------------------------------------

enum InterventionStatus {
  PENDING
  SENT
  FAILED
  DISMISSED
  ACCEPTED
}

// ---------------------------------------------------------------------------
// NextAuth.js adapter models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  serverRoles   UserServerRole[]

  createdAt     DateTime  @default(now())
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// RBAC: maps an authenticated User to their Discord guild roles
// ---------------------------------------------------------------------------

model UserServerRole {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Discord guild (server) snowflake ID
  discordGuildId String
  role           ServerRole
  createdAt      DateTime   @default(now())

  @@unique([userId, discordGuildId])
  @@index([discordGuildId, role])
}

// ---------------------------------------------------------------------------
// Core domain models
// ---------------------------------------------------------------------------

model Team {
  id             String   @id @default(cuid())
  name           String
  /// The Discord guild (server) snowflake that this team monitors.
  /// Separate from channel/thread IDs. Used for RBAC joining.
  discordGuildId String?
  platform       Platform @default(DISCORD)
  createdAt      DateTime @default(now())

  members       Member[]
  threads       ConversationThread[]
  interventions Intervention[]

  @@index([discordGuildId])
}

model Member {
  id             String   @id @default(cuid())
  teamId         String
  team           Team     @relation(fields: [teamId], references: [id])
  displayName    String
  platformUserId String
  platform       Platform
  createdAt      DateTime @default(now())

  messages      Message[]
  interventions Intervention[]

  /// Prevent duplicate members per team per platform user
  @@unique([teamId, platformUserId])
}

model ConversationThread {
  id         String       @id @default(cuid())
  teamId     String
  team       Team         @relation(fields: [teamId], references: [id])
  platform   Platform
  /// channel/thread id on the source platform (NOT the guild id)
  externalId String
  /// Discord guild snowflake — stored for routing/context
  guildId    String?
  status     ThreadStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  closedAt   DateTime?
  /// Set when the thread is moved to ARCHIVED status.
  archivedAt DateTime?
  purgedAt   DateTime?    // set once raw text has been deleted by retention job

  messages       Message[]
  signals        MessageSignal[]
  tensionHistory TensionSnapshot[]
  interventions  Intervention[]

  /// Prevent duplicate threads per team per platform channel
  @@unique([teamId, externalId, platform])
  @@index([teamId, status])
}

// Raw text lives here. Deleted (rawText set to null) by the retention job
// once status = CLOSED/ARCHIVED and the retention window elapses.
model Message {
  id         String   @id @default(cuid())
  threadId   String
  thread     ConversationThread @relation(fields: [threadId], references: [id])
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  /// External platform message ID — used for deduplication.
  externalId String?  @unique
  rawText    String?  // nullable: purged after thread close
  sentAt     DateTime
  createdAt  DateTime @default(now())

  signal     MessageSignal?

  @@index([threadId, sentAt])
}

// Derived, long-lived signals — survive raw text purge.
model MessageSignal {
  id            String   @id @default(cuid())
  messageId     String   @unique
  message       Message  @relation(fields: [messageId], references: [id])
  threadId      String
  thread        ConversationThread @relation(fields: [threadId], references: [id])

  /// Sentiment score: -1 (very negative) to 1 (very positive). From AI.
  sentiment     Float
  /// Primary detected emotion label from AI (e.g. "anger", "frustration"). Null until computed.
  emotion       String?
  /// Reply gap in milliseconds from previous message in thread. Null for first message.
  replyGapMs    Int?
  /// True if message was sent while a previous message was still unacknowledged.
  interruption  Boolean  @default(false)
  /// Measured signals that fired for this message (structured, not LLM-invented).
  signalCodes   String[]

  createdAt     DateTime @default(now())

  @@index([threadId, createdAt])
}

// Rolling conflict-prediction snapshots — the backbone of the Team Health
// Dashboard and Relationship Timeline. Independent of raw message retention.
model TensionSnapshot {
  id           String   @id @default(cuid())
  threadId     String
  thread       ConversationThread @relation(fields: [threadId], references: [id])

  tensionScore Float    // 0..1 — computed by deterministic risk engine (not LLM)
  riskLevel    String   // LOW | MEDIUM | HIGH | CRITICAL
  trend        Float    // delta vs previous snapshot (positive = rising, negative = falling)
  confidence   Float    // 0..1
  /// Explainability: structured signal codes that fired (e.g. ["NEGATIVE_SENTIMENT", "RAPID_REPLY_BURST"])
  signalsFired String[]
  /// Human-readable explanations matching signalsFired (for display)
  signalLabels String[]
  /// AI-generated mediation suggestion. Null when circuit breaker is open.
  mediationSuggestion String?

  createdAt    DateTime @default(now())

  @@index([threadId, createdAt])
}

// ---------------------------------------------------------------------------
// Intervention: tracks nudge delivery lifecycle
// ---------------------------------------------------------------------------

model Intervention {
  id             String             @id @default(cuid())
  teamId         String
  team           Team               @relation(fields: [teamId], references: [id])
  threadId       String
  thread         ConversationThread @relation(fields: [threadId], references: [id])
  memberId       String?
  member         Member?            @relation(fields: [memberId], references: [id])
  platformUserId String
  platform       Platform
  /// The message actually sent to the user
  message        String
  status         InterventionStatus @default(PENDING)
  /// Populated on FAILED status
  errorMessage   String?
  createdAt      DateTime           @default(now())
  sentAt         DateTime?

  @@index([teamId, createdAt])
  @@index([threadId, createdAt])
}
