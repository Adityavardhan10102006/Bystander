    "bullmq": "^6.1.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "discord.js": "^14.15.3",
    "ioredis": "^5.4.1",
    "lucide-react": "^1.31.0",
    "next": "^14.2.5",
    "next-auth": "^4.24.15",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
