# Discord Bot environment variables
# Copy this file to .env and fill in real values before running.
# NEVER commit the actual .env file to version control.

# ── Discord ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# ── Bystander API ──────────────────────────────────────────────────────────
# Base URL of the deployed Next.js app (no trailing slash).
# Locally this is usually http://localhost:3000
# On Railway/Vercel it's your production domain.
BYSTANDER_API_URL=https://your-bystander-app.vercel.app

# ── Internal notify HTTP server (bot/server.ts) ────────────────────────────
# Port the bot's POST /notify endpoint listens on. Default: 3001.
# Only reachable from within the same host / Railway private network.
NOTIFY_PORT=3001

# Optional bearer token that callers must include as:
#   Authorization: Bearer <NOTIFY_SECRET>
# Leave blank (or omit) to disable auth (fine on Railway's private network).
NOTIFY_SECRET=
