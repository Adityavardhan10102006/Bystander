# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/bystander"

# --- Redis (queues + pub/sub for realtime) ---
REDIS_URL="redis://localhost:6379"

# --- Hosted AI provider (used for NLP: sentiment/emotion/conflict signals
# AND for mediation generation — one provider, one contract) ---
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-6"

# --- Chat platform: Discord (first integration) ---
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""
DISCORD_CLIENT_ID=""

# --- Message retention ---
# Raw text purge job interval, in hours, for closed/archived threads
RETENTION_PURGE_INTERVAL_HOURS=24

# --- App ---
NEXTAUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
